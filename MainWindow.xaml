<Window x:Class="TerraForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Seed:"/>
            <TextBox x:Name="SeedTextBox" Text="42" TextChanged="SeedTextBox_TextChanged" Margin="0,0,0,5"/>
            <Button Content="Randomize Seed" Click="RandomizeSeedButton_Click" Margin="0,0,0,10"/>
            
            <CheckBox x:Name="IslandModeCheckBox" Content="Island Mode" IsChecked="True" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Margin="0,0,0,10"/>

            <TextBlock Text="View Mode:"/>
            <RadioButton x:Name="ColorMapRadio" Content="Color Map" IsChecked="True" Checked="RadioButton_Checked"/>
            <RadioButton x:Name="HeightMapRadio" Content="Height Map" Checked="RadioButton_Checked"/>
            <RadioButton x:Name="MoistureMapRadio" Content="Moisture Map" Checked="RadioButton_Checked" Margin="0,0,0,10"/>
            
            <TextBlock Text="Scale:"/>
            <Slider x:Name="ScaleSlider" Minimum="0.001" Maximum="0.2" Value="0.05" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="ScaleValueText" Text="0.0500"/>
            
            <TextBlock Text="Octaves:" Margin="0,10,0,0"/>
            <Slider x:Name="OctavesSlider" Minimum="1" Maximum="10" Value="6" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="OctavesValueText" Text="6"/>
            
            <TextBlock Text="Persistence:" Margin="0,10,0,0"/>
            <Slider x:Name="PersistenceSlider" Minimum="0.1" Maximum="1.0" Value="0.5" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="PersistenceValueText" Text="0.50"/>
            
            <TextBlock Text="Lacunarity:" Margin="0,10,0,0"/>
            <Slider x:Name="LacunaritySlider" Minimum="1.0" Maximum="4.0" Value="2.0" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="LacunarityValueText" Text="2.00"/>
        </StackPanel>
        
        <Image x:Name="MapImage" Grid.Column="1" Stretch="Uniform"/>
    </Grid>
</Window>
